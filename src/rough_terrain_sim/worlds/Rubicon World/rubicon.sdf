<sdf version="1.6">
  <world name="challenge">

    <scene>
      <ambient>.4 .4 .4</ambient>
      <sky></sky>
    </scene>

    <!-- Rubicon rough terrain -->
    <include>
      <name>Rubicon</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Rubicon</uri>
    </include>

    <!-- Our rover -->
    <include>
      <name>rough_terrain_rover</name>
      <uri>model://rover</uri>
      <pose>0 0 2 0 0 0</pose>
    </include>

  </world>
</sdf>
